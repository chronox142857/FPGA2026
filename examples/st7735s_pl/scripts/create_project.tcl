set root [file normalize [file join [file dirname [info script]] ..]]
file mkdir [file join $root build]
create_project -force st7735s_7010 [file join $root build vivado] -part xc7z010clg400-1
set_property target_language Verilog [current_project]
set_property simulator_language Verilog [current_project]
foreach name {st7735s_spi_byte.v st7735s_driver.v st7735s_readback.v st7735s_demo.v st7735s_font5x7.v st7735s_text_demo.v st7735s_top.v} {
    add_files -norecurse [file join $root $name]
}
set debug_enabled [expr {[info exists ::env(LCD_DEBUG)] && $::env(LCD_DEBUG) eq "1"}]
if {$debug_enabled} {
    set_property verilog_define LCD_DEBUG [get_filesets sources_1]
    set readback_enabled [expr {[info exists ::env(LCD_READBACK)] && $::env(LCD_READBACK) eq "1"}]
    set_property generic READBACK_ENABLE=$readback_enabled [get_filesets sources_1]
    create_ip -name ila -vendor xilinx.com -library ip -version 6.2 -module_name lcd_ila
    set_property -dict [list CONFIG.C_NUM_OF_PROBES 3 CONFIG.C_PROBE0_WIDTH 8 \
        CONFIG.C_PROBE1_WIDTH 32 CONFIG.C_PROBE2_WIDTH 1 \
        CONFIG.C_EN_STRG_QUAL 1 CONFIG.C_DATA_DEPTH 16384] [get_ips lcd_ila]
    generate_target all [get_ips lcd_ila]
    create_ip -name vio -vendor xilinx.com -library ip -version 3.0 -module_name lcd_vio
    set_property -dict [list CONFIG.C_NUM_PROBE_IN 5 CONFIG.C_NUM_PROBE_OUT 1 \
        CONFIG.C_PROBE_OUT0_WIDTH 1 CONFIG.C_PROBE_OUT0_INIT_VAL 0x0 \
        CONFIG.C_PROBE_IN0_WIDTH 32 CONFIG.C_PROBE_IN1_WIDTH 32 \
        CONFIG.C_PROBE_IN2_WIDTH 32 CONFIG.C_PROBE_IN3_WIDTH 32 CONFIG.C_PROBE_IN4_WIDTH 8] [get_ips lcd_vio]
    generate_target all [get_ips lcd_vio]
}
add_files -fileset constrs_1 -norecurse [file join $root constraints linhangz_7010_st7735s.xdc]
add_files -fileset sim_1 -norecurse [file join $root tb_st7735s_driver.v]
add_files -fileset sim_1 -norecurse [file join $root tb_st7735s_top.v]
add_files -fileset sim_1 -norecurse [file join $root tb_st7735s_readback.v]
add_files -fileset sim_1 -norecurse [file join $root tb_st7735s_slow.v]
add_files -fileset sim_1 -norecurse [file join $root reference slow_gpio_init.hex]
add_files -fileset sim_1 -norecurse [file join $root tb_st7735s_stm32.v]
add_files -fileset sim_1 -norecurse [file join $root tb_st7735s_text.v]
# Generated by running the original STM32 C recorder in scripts/test.ps1.
if {[file exists [file join $root build sim stm32_wire_stream.hex]]} {
    add_files -fileset sim_1 -norecurse [file join $root build sim stm32_wire_stream.hex]
}
set_property top st7735s_top [get_filesets sources_1]
set_property top tb_st7735s_driver [get_filesets sim_1]
update_compile_order -fileset sources_1
update_compile_order -fileset sim_1
puts "PROJECT_READY=[file join $root build vivado st7735s_7010.xpr]"
